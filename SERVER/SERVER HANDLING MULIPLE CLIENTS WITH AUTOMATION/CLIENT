package com.sys.main; // package declaration

import java.io.*; // input-output classes
import java.net.*; // networking classes
import java.util.concurrent.*; // concurrency utilities (ExecutorService)

public class ClientSimulator {

    public static void main(String[] args) {

        // Number of clients we want to simulate
        int numberOfClients = 500; // can increase later to 1000+

        // Create a thread pool with 100 worker threads
        // These threads will simulate clients
        ExecutorService executor = Executors.newFixedThreadPool(100);

        // Loop to create multiple clients
        for (int i = 0; i < numberOfClients; i++) {

            // Store client id for identification
            int clientId = i;

            // Submit a task to thread pool
            executor.submit(() -> {

                try {

                    // Create a socket and connect to server running on localhost port 5000
                    Socket socket = new Socket("localhost", 5000);

                    // Writer to send data to server
                    PrintWriter writer = new PrintWriter(
                            socket.getOutputStream(), true);

                    // Reader to receive data from server
                    BufferedReader reader = new BufferedReader(
                            new InputStreamReader(socket.getInputStream()));

                    // Send a message to the server
                    writer.println("Hello from client " + clientId);

                    // Read server response
                    String response = reader.readLine();

                    // Print response received from server
                    System.out.println("Client " + clientId + " received: " + response);

                    // Close client socket
                    socket.close();

                } catch (Exception e) {

                    // Print exception if error occurs
                    e.printStackTrace();
                }
            });

            try {

                // Pause for 50 milliseconds before creating next client
                // This prevents too many connections instantly
                Thread.sleep(50);

            } catch (InterruptedException e) {

                // Handle interruption exception
                e.printStackTrace();
            }
        }

        // Stop accepting new tasks and shutdown executor
        executor.shutdown();
    }
}
