package com.sys.main; // defines the package where this class belongs

import java.io.*; // imports input-output classes (BufferedReader, PrintWriter etc.)
import java.net.*; // imports networking classes (ServerSocket, Socket)

public class MultiClientServer {

    public static void main(String[] args) {

        try {

            // Create a server socket that listens on port 5000
            ServerSocket serverSocket = new ServerSocket(5000);

            // Print message to show server started successfully
            System.out.println("Server started on port 5000...");

            // Infinite loop so the server keeps running
            while (true) {

                // Wait (block) until a client connects
                Socket socket = serverSocket.accept();

                // Print information about the connected client
                System.out.println("Client connected: " + socket);

                // Create a new thread to handle the client
                // This allows multiple clients to connect at the same time
                new Thread(new ClientHandler(socket)).start();
            }

        } catch (Exception e) {

            // If any error occurs, print stack trace
            e.printStackTrace();
        }
    }
}


// This class handles communication with each client
class ClientHandler implements Runnable {

    // Socket object representing the connected client
    private Socket socket;

    // Constructor receives client socket from server
    ClientHandler(Socket socket) {

        // Store the socket so we can use it inside run()
        this.socket = socket;
    }

    // run() method executes when the thread starts
    public void run() {

        try {

            // Create reader to read text from the client
            BufferedReader reader = new BufferedReader(
                    new InputStreamReader(socket.getInputStream()));

            // Create writer to send text to the client
            PrintWriter writer = new PrintWriter(
                    socket.getOutputStream(), true);

            // Read one line message sent by the client
            String message = reader.readLine();

            // Print the received message on the server console
            System.out.println("Message from client: " + message);

            // Send response back to the client
            writer.println("Server received: " + message);

            // Close the client connection
            socket.close();

        } catch (Exception e) {

            // Print error if something goes wrong
            e.printStackTrace();
        }
    }
} 
